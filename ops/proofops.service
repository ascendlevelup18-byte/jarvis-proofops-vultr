# /etc/systemd/system/proofops.service  (installed by ops/deploy-app.sh)
[Unit]
Description=JARVIS ProofOps control plane
After=network-online.target docker.service
Requires=docker.service

[Service]
User=proofops
Group=proofops
WorkingDirectory=/opt/proofops/app
# Planner, model and deployment label come from /etc/proofops/control.env (no secrets in this unit file).
EnvironmentFile=/etc/proofops/control.env
Environment=PROOFOPS_HOST=127.0.0.1
Environment=PROOFOPS_INFERENCE_ENV_FILE=/etc/proofops/inference.env
Environment=HOME=/var/lib/proofops
# Public demo limits: Caddy sets X-Forwarded-For; per-client and daily caps bound load and model spend.
Environment=PROOFOPS_TRUST_PROXY=1
Environment=PROOFOPS_RUNS_PER_MIN=6
Environment=PROOFOPS_MAX_RUNS_PER_DAY=150
Environment=PROOFOPS_EVIDENCE_KEEP=300
# Hard ceiling on live inference spend for this deployment, checked before every model call (inference-budget.ts).
# Prices are double the recorded catalog rate, so the real spend is lower. The ledger is in the data directory.
Environment=PROOFOPS_BUDGET_USD=3
Environment=PROOFOPS_PRICE_INPUT_PER_M=0.30
Environment=PROOFOPS_PRICE_OUTPUT_PER_M=1.20
Environment=PROOFOPS_REQUIRE_BUDGET=1
# Refuses to start without runsc, the worker image, or (live planner) the key: it never falls back silently.
ExecStart=/usr/local/bin/node apps/proofops/src/server.ts --sandbox --port 4317 --deployment ${PROOFOPS_DEPLOYMENT} --evidence /var/lib/proofops/evidence --data /var/lib/proofops/data
# /run/proofops holds the per-run gateway sockets; recreated on each start, so stale sockets never survive.
RuntimeDirectory=proofops
RuntimeDirectoryMode=0711
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/proofops /run/proofops
CapabilityBoundingSet=
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
