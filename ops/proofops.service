# /etc/systemd/system/proofops.service  (installed by ops/deploy-app.sh; NOT YET USED)
[Unit]
Description=JARVIS ProofOps control plane
After=network-online.target docker.service
Requires=docker.service

[Service]
User=proofops
Group=proofops
WorkingDirectory=/opt/proofops/app
# Model id and deployment label come from /etc/proofops/control.env (no secrets in this unit file).
EnvironmentFile=/etc/proofops/control.env
Environment=PROOFOPS_HOST=127.0.0.1
Environment=PROOFOPS_INFERENCE_ENV_FILE=/etc/proofops/inference.env
ExecStart=/usr/bin/node apps/proofops/src/server.ts --sandbox --planner vultr --model ${PROOFOPS_MODEL} --port 4317 --deployment ${PROOFOPS_DEPLOYMENT} --evidence /var/lib/proofops/evidence --data /var/lib/proofops/data
# /run/proofops holds the per-run gateway sockets; recreated on each start, so stale sockets never survive.
RuntimeDirectory=proofops
RuntimeDirectoryMode=0711
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/proofops /run/proofops
CapabilityBoundingSet=
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
