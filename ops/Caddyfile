# /etc/caddy/Caddyfile  (installed by ops/deploy-app.sh)
# PROOFOPS_HOSTNAME is e.g. 203-0-113-7.sslip.io. Caddy obtains the certificate automatically
# (Let's Encrypt, falling back to ZeroSSL).
{$PROOFOPS_HOSTNAME} {
	encode gzip
	reverse_proxy 127.0.0.1:4317 {
		# Server-Sent Events: stream run progress without buffering.
		flush_interval -1
	}
	header Strict-Transport-Security "max-age=31536000"
}
