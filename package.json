{
  "name": "jarvis-proofops-vultr",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS: autonomous ecommerce exception resolver (duplicate charge workflow)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "proofops:typecheck": "tsc -p apps/proofops",
    "proofops:test": "node --test apps/proofops/test/*.test.ts apps/api/test/*.test.ts",
    "proofops:check": "npm run proofops:typecheck && npm run proofops:test",
    "proofops:run": "node apps/proofops/src/cli.ts",
    "proofops:e2e": "node --test --test-concurrency=1 apps/proofops/e2e/*.test.ts",
    "proofops:demo": "node apps/proofops/src/server.ts",
    "proofops:smoke": "node apps/proofops/src/smoke.ts",
    "proofops:release": "node apps/proofops/src/release-gate.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
