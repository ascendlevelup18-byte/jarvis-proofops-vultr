# JARVIS ProofOps configuration reference. Placeholders only; never commit real values.
# On the VM these live in /etc/proofops/ (see ops/proofops.service and ops/deploy-app.sh).
# The browser worker never receives any of them.

# Planner: "stub" (scripted, labelled as such) or "vultr" (Vultr Serverless Inference)
PROOFOPS_PLANNER=stub
PROOFOPS_MODEL=<model-id-from-the-provider-catalog>
# File holding PROOFOPS_INFERENCE_API_KEY=... (mode 600, installed with ops/set-inference-key.ps1)
PROOFOPS_INFERENCE_ENV_FILE=/etc/proofops/inference.env

# Control plane
PROOFOPS_HOST=127.0.0.1
PROOFOPS_PORT=4317
# Set to 1 only behind our own Caddy, which sets X-Forwarded-For
PROOFOPS_TRUST_PROXY=0
PROOFOPS_RUNS_PER_MIN=10
PROOFOPS_MAX_RUNS_PER_DAY=200
PROOFOPS_EVIDENCE_KEEP=300
