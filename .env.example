# JARVIS ProofOps environment template. Placeholders only; never commit real values.
# Secrets are entered on the Vultr VM at hidden prompts, never in chat or in the browser bundle.

# Vultr Serverless Inference (OpenAI-compatible)
PROOFOPS_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
PROOFOPS_INFERENCE_API_KEY=<set-on-server-only>
PROOFOPS_INFERENCE_MODEL=<verified-model-id-from-model-list>

# Operator console access (single operator token for the demo)
PROOFOPS_OPERATOR_TOKEN=<random-32+-chars>

# Database (ProofOps-only role; never the ACT III service-role key)
PROOFOPS_DATABASE_URL=<postgres-url-for-proofops_app-role>

# Sandbox limits
PROOFOPS_SANDBOX_IMAGE=<pinned-playwright-image-digest>
PROOFOPS_SANDBOX_TIMEOUT_MS=60000
PROOFOPS_SANDBOX_MEMORY_MB=1024
PROOFOPS_ALLOWED_ORIGINS=<synthetic-store-origin>
